<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Registro</title>
    <link rel="stylesheet" href="resources/css/styles.css">
</head>
<body>
    <main class="container">
        <section id="role-selection-section" class="auth-card seccion">
            <div class="card-header form-group">
                <h2>Registrate como:</h2>
                <a class="back" href="/">Volver a Inicio</a>
                <button class="btn btn-secondary" onclick="mostrarOcultar('Registro-admin', 'role-selection-section')">Administrador</button>
                <button class="btn btn-secondary" onclick="mostrarOcultar('Registro-docente', 'role-selection-section')">Docente</button>
                <button class="btn btn-secondary" onclick="mostrarOcultar('Registro-students', 'role-selection-section')">Estudiante</button>
            </div>
        </section>

        <section hidden class="auth-card seccion" id="Registro-admin">
            <div class="form-group">
                <h2>Registrate como Administrador</h2>
                <a class="btn-back" href="#" onclick="mostrarOcultar('role-selection-section', 'Registro-admin')">regresar</a>
                <form action="register" method="POST">
                    
                    <input type="hidden" name="rol" value="admin">

                    <label for="mail">Correo Institucional</label>
                    <input type="text" id="mail" name="correo">

                    <label for="user">Usuario</label>
                    <input type="text" id="user" name="user">

                    <label for="name">Nombre Completo</label>
                    <input type="text" id="name" name="name">

                    <label for="password">Contraseña</label>
                    <input type="password" id="password" name="password">

                    <label for="confirm-password">Confirmar Contraseña</label>
                    <input type="password" id="confirm-password" name="confirm-password">

                    <input type="submit" class="btn" value="save">
                    <p>¿Ya tienes una cuenta? <a class="btn"  href="login" id="go-to-login" onclick="mostrarOcultar('login-section', 'Registro-admin')">Inicia sesión aquí</a></p>
                </form>
            </div>
        </section>

        <section hidden class="auth-card seccion" id="Registro-docente">
            <div class="form-group">
                <h2>Registrate como Docente</h2>
                <a class="btn-back" href="#" onclick="mostrarOcultar('role-selection-section', 'Registro-docente')">regresar</a>
                <form action="register" method="POST">
                    
                    <input type="hidden" name="rol" value="docente">

                    <label for="mail">Correo Institucional</label>
                    <input type="text" id="mail">

                    <label for="user">Usuario</label>
                    <input type="text" id="user">

                    <label for="name">Nombre Completo</label>
                    <input type="text" id="name">

                    <label for="password">Contraseña</label>
                    <input type="password" id="password">

                    <label for="confirm-password">Confirmar Contraseña</label>
                    <input type="password" id="confirm-password">

                    <input type="submit" class="btn" value="save">
                    <p>¿Ya tienes una cuenta? <a class="btn"  href="login" id="go-to-login" onclick="mostrarOcultar('login-section', 'Registro-docente')">Inicia sesión aquí</a></p>
                </form>
            </div>
        </section>

        <section hidden class="auth-card seccion" id="Registro-students">
            <div class="login-student form-group">
                <h2>Registrate como Estudiante</h2>
                <a class="btn-back" href="#" onclick="mostrarOcultar('role-selection-section', 'Registro-students')">regresar</a>
                <form action="/register" method="POST">

                    <input type="hidden" name="rol" value="estudiante">
                    <label for="mail">Correo Institucional</label>
                    <input type="text" id="mail" name="correo">

                    <label for="user">Usuario</label>
                    <input type="text" id="user" name="user">

                    <label for="name">Nombre Completo</label>
                    <input type="text" id="name" name="name">

                    <label for="student-code">Código de Estudiante</label>
                    <input type="text" id="codigo" name="codigo">

                    <label for="programa">Programa</label>
                    <select id="programa" name="programa">

                        <option value="" disabled selected>Selecciona un programa</option>

                        <option value="Administracion-De-Empresas"> Administracion De Empresas</option>

                        <option value="Contaduria-Publica">Contaduria Publica</option>

                        <option value="Comunicacion-Social-Periodismo"> Comunicacion Social-Periodismo</option>

                        <option 
                        value="Administracion-deempresas-turisticas-y-hoteleras"> Administracion de Empresas Turisticas y Hoteleras</option>

                        <option value="Ingenieria-mecanica">Ingeniería Mecánica</option>

                        <option value="Derecho">Derecho</option>

                        <option 
                        value="Negocios-y-finanzas-internacionales"> Negocios y Finanzas Internacionales</option>

                        <option value="Psicologia">Psicología</option>

                        <option value="Ingenieria-mecatronica"> Ingeniería Mecatrónica</option>

                        <option value="Administracion-maritima-y-fluvial"> Administracion Maritima y Fluvial</option>
                        
                        <option value="Diseño-grafico">Diseño Gráfico</option>

                        <option value="Diseño-de-espacios">Diseño de Espacios</option>

                        <option value="Diseño-de-modas">Diseño de Modas</option>

                        <option value="Deporte-y-cultura-fisica">Deporte y Cultura Física</option>

                        <option value="Ciencias-Politicas">Ciencias Politicas</option>

                        <option value="comunicacion-audiovisual"> Comunicación Audiovisual</option>

                        <option value="tecnica-profesional-en-operaciones-logisticas">Técnica profesional en operaciones logísticas</option>

                        <option value="Ingenieria-electronica">Ingeniería Electrónica</option>

                        <option value="Ingenieria-de-sistemas"> Ingeniería de Sistemas</option>

                        <option value="Arquitectura">Arquitectura</option>

                        <option value="Ingenieria-sistemas">Ingeneiria de Sistemas</option>

                    </select>

                    <label for="password">Contraseña</label>
                    <input type="password" id="password">

                    <label for="confirm-password">Confirmar Contraseña</label>
                    <input type="password" id="confirm-password">

                    <input type="submit" class="btn" value="save">
                    <p>¿Ya tienes una cuenta? <a class="btn" href="login" id="go-to-login" onclick="mostrarOcultar('login-section', 'Registro-students')">Inicia sesión aquí</a></p>
                </form>
            </div>
        </section>
    </main>
    <script>
        function mostrarOcultar(idMostrar, idOcultar) {
            document.getElementById(idMostrar).hidden = false;
            document.getElementById(idOcultar).hidden = true;
        }
    </script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <% if (typeof alertMessage !== 'undefined') { %>
        <script>
            Swal.fire({
                title: '<%= alertTitle %>',
                text: '<%= alertMessage %>',
                icon: '<%= alertIcon %>',
                showConfirmButton: <%= showConfirmButton %>,
                timer: <%= timer %>
            }).then(() => {
                window.location = '/<%= ruta %>';
            });
        </script>
    <% } %>

</body>
</html>